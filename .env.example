# Создайте файл .env на основе этого примера и впишите собственные значения.
PORT=3000
NODE_ENV=development

# Ключ API с платформы OpenAI. Не вставляйте его в файлы public/ и не публикуйте.
OPENAI_API_KEY=
# Модель должна быть доступна вашему API-аккаунту; при необходимости замените значение.
OPENAI_MODEL=gpt-6-luna
OPENAI_API_URL=https://api.openai.com/v1/responses

# Длинный случайный секрет для административного раздела /admin.html.
ADMIN_TOKEN=

# Необязательно: отправка уведомлений о новых заявках на e-mail.
# Без SMTP заявки сохраняются в data/requests.json и доступны в административном разделе.
CONTACT_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Необязательно: папка для постоянного хранения JSON-файлов заявок и отзывов.
# На хостинге укажите постоянный диск/volume, если файловая система не сохраняется между перезапусками.
# DATA_DIR=
